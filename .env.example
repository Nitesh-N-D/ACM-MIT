# Copy to .env.local and fill in. Never commit real values.

# Public (safe in the browser): Supabase project URL and anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_. Used solely to provision the
# first Super Admin and to look up accounts for role management.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Comma-separated e-mail addresses that are provisioned as
# Super Admin after they sign in with a verified e-mail. Leave empty to use
# the chapter account (acmmitstudentchapter@gmail.com, src/config/admin.ts).
# That account signs in at /admin/sign-in with a password; create it once in
# Supabase: Dashboard -> Authentication -> Users -> Add user (auto-confirm).
# Never put the password in this file or anywhere in the repository.
ADMIN_EMAILS=

# Set to "true" to require a second factor (authenticator app) for /admin.
ADMIN_REQUIRE_MFA=false

# Canonical site origin, used in e-mail links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
